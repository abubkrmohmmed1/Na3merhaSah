        "/api/v1/b2b/batch/geocode": {
            "post": {
                "tags": [
                    "B2B Batch"
                ],
                "summary": "معالجة دفعة من الإحداثيات",
                "description": "استقبال مصفوفة من الإحداثيات (lat/lng) وإرجاع العناوين + الأحياء + S2 Tokens. يدعم حتى 500 نقطة في المرة الواحدة.",
                "operationId": "batchGeocode",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "points"
                                ],
                                "properties": {
                                    "points": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "lat": {
                                                    "type": "number",
                                                    "example": 15.5871
                                                },
                                                "lng": {
                                                    "type": "number",
                                                    "example": 32.5232
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "نتائج المعالجة الدفعية"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/spatial/pending-counts": {
            "get": {
                "tags": [
