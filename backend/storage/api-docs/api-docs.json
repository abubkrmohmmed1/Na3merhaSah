                                "properties": {
                                    "field": {
                                        "type": "string",
                                        "enum": [
                                            "name",
                                            "layer",
                                            "lat",
                                            "lng",
                                            "description"
                                        ]
                                    },
                                    "new_value": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "تم إرسال الاقتراح"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
