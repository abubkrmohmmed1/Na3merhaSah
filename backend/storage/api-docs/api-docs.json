{
    "openapi": "3.0.0",
    "info": {
        "title": "توثيق واجهات نظام نعمرها صح",
        "description": "API Documentation for Namerha Sah platform",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/addresses/reverse": {
            "post": {
                "tags": [
                    "Addressing"
                ],
                "summary": "جلب العنوان من الإحداثيات",
                "description": "تحويل خطوط الطول والعرض (lat, lng) إلى عنوان مقروء S2 Token.",
                "operationId": "addressReverse",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "lat",
                                    "lng"
                                ],
                                "properties": {
                                    "lat": {
                                        "type": "number",
                                        "example": 24.7136
                                    },
                                    "lng": {
                                        "type": "number",
                                        "example": 46.6753
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "نجاح"
                    },
                    "404": {
                        "description": "لم يتم العثور على عنوان"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/addresses/search": {
            "get": {
                "tags": [
                    "Addressing"
                ],
                "summary": "البحث عن عنوان",
                "description": "البحث النصي عن العناوين في قاعدة البيانات الجغرافية.",
                "operationId": "addressSearch",
                "parameters": [
                    {
                        "name": "query",
                        "in": "query",
                        "description": "كلمة البحث",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "lat",
                        "in": "query",
                        "description": "للبحث الأقرب للموقع",
                        "required": false,
                        "schema": {
                            "type": "number"
                        }
                    },
                    {
                        "name": "lng",
                        "in": "query",
                        "description": "للبحث الأقرب للموقع",
                        "required": false,
                        "schema": {
                            "type": "number"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "نتائج البحث"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "تسجيل الدخول",
                "description": "تسجيل دخول المواطن عبر رقم الهاتف وكلمة المرور.",
                "operationId": "authLogin",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone",
                                    "password"
                                ],
                                "properties": {
                                    "phone": {
                                        "type": "string",
                                        "example": "0500000000"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "تم تسجيل الدخول بنجاح"
                    },
                    "401": {
                        "description": "بيانات الدخول غير صحيحة"
                    }
                }
            }
        },
        "/api/v1/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "إنشاء حساب جديد",
                "description": "إنشاء حساب مواطن جديد للحصول على توكن الوصول.",
                "operationId": "authRegister",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "phone",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "أحمد محمد"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "0500000001"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    },
                                    "national_id": {
                                        "type": "string",
                                        "example": "1000000001"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "تم إنشاء الحساب بنجاح"
                    },
                    "422": {
                        "description": "خطأ في التحقق من البيانات"
                    }
                }
            }
        },
